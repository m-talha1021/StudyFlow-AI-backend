# StudyFlow AI backend — environment variables (Vercel -> Settings -> Environment Variables)
# Copy to .env for local development. NEVER commit real keys or the service-account JSON.

# --- AI providers (required: at least GEMINI_API_KEY) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# OpenAI is an optional PAID fallback, off by default. Only set to true if you accept paid calls.
ENABLE_OPENAI_FALLBACK=false
OPENAI_API_KEY=

# --- Firebase Auth (REQUIRED for Phase 1: backend verifies Firebase ID tokens) ---
# Set exactly ONE of these two in Vercel. The service account must belong to the
# same Firebase project the frontend signs users into (see frontend VITE_FIREBASE_*).
# 1) Paste the whole service-account JSON as-is:
FIREBASE_SERVICE_ACCOUNT=
# 2) OR paste the same JSON base64-encoded (use this if pasting raw JSON is awkward):
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Optional: override the Firebase project used to verify tokens.
# (Normally read from the service-account JSON; only set if verification fails.)
FIREBASE_PROJECT_ID=
# If NEITHER service-account var is set, Application Default Credentials are tried
# (GOOGLE_APPLICATION_CREDENTIALS). If no credentials exist, protected endpoints
# answer 503 until one is set — the server never runs unauthenticated.

# --- Quotas / rate limits (all optional; defaults shown) ---
# These are the FREE plan limits. The user's plan is read from Firestore
# users/{uid} `plan` ("free" or "pro"; missing/invalid -> "free") and Pro
# limits are 10x these (500 AI calls/day, 300 transcription minutes/day).
# The feedback limit is the same for every plan.
# Per-user daily AI generation calls (material, generate, flashcards,
# test-concepts, chat, oral-exam, generate-pdf).
QUOTA_GENERATION_PER_DAY=5
# Per-user daily transcription audio minutes (WAV measured exactly; other
# formats estimated from file size at ~160 kbps).
QUOTA_TRANSCRIPTION_MINUTES_PER_DAY=20
# Global requests/minute per client IP (all /api/* except /api/test).
RATE_LIMIT_REQUESTS_PER_MINUTE=120
# Per-user feedback messages per hour.
FEEDBACK_PER_HOUR=10

# --- Billing — Stripe scaffolding (Phase 2, FREE-ONLY for now) ---
# The product is free-only: do NOT set these until the owner wires up a
# Stripe account and is ready to take payments. With all three unset the
# billing endpoints answer 503 and no Stripe call is ever made. When
# they are set, checkout + webhook start working with no code change.
# NEVER commit real values.
# Secret key from the Stripe Dashboard (Developers -> API keys).
STRIPE_SECRET_KEY=
# Price ID of the Pro monthly subscription (Stripe Dashboard ->
# Product catalog -> the Pro monthly price; starts with "price_").
STRIPE_PRICE_PRO_MONTHLY=
# Signing secret of the webhook endpoint (Stripe Dashboard ->
# Developers -> Webhooks; starts with "whsec_").
STRIPE_WEBHOOK_SECRET=

# --- Feedback email (Resend) ---
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
RESEND_FROM_EMAIL=

# --- Optional tuning ---
# FRONTEND_ORIGINS=https://study-flow-ai-lac.vercel.app,http://localhost:5173
# GROQ_TIMEOUT_SECONDS=18
# OPENROUTER_TIMEOUT_SECONDS=18
# MAX_MATERIAL_CHARS=120000
# MAX_AI_PROMPT_CHARS=36000
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.6-flash
# GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
# OPENROUTER_MODELS=openrouter/free

# NOTE: quotas and rate limits are stored IN MEMORY. They reset on cold start /
# redeploy and are per-instance on Vercel. A durable store (Firestore/Redis)
# is the Phase 2 upgrade if abuse becomes real.
